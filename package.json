{
  "name": "juego-urbano",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:cobertura": "node tools/pruebas-suaves.mjs vitest run --coverage",
    "test:catalogo": "vitest run tests/catalogo.test.ts tests/npcs.test.ts",
    "test:e2e": "node tools/pruebas-suaves.mjs playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run test:cobertura && npm run test:e2e",
    "licencias": "node tools/licencias.mjs",
    "pnj": "node tools/npcs/generar.mjs",
    "retratos": "node tools/revision/retratos.mjs",
    "verificar": "tsc -b && npm run test:cobertura && npm run licencias && npm run test:e2e",
    "verificar:ci": "tsc -b && npm run test:cobertura && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
